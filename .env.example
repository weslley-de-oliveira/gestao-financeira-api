# Copie para .env e ajuste. O .env não é versionado.
# Valores inválidos impedem a API de iniciar (src/config/env.ts).

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origens com CORS liberado, separadas por vírgula. Em produção, deixe vazio (mesma origem).
CORS_ORIGINS=http://localhost:4200
# Endereço público do front em produção. POST/PATCH/DELETE só são aceitos dele, das origens de
# CORS ou da própria API (verificação do cabeçalho Origin, contra CSRF). Em desenvolvimento, vazio.
APP_ORIGIN=

# Banco: o docker-compose.yml sobe o Postgres local na porta 5433.
DATABASE_URL=postgres://gestao:gestao@localhost:5433/gestao_financeira
DATABASE_POOL_MAX=10
# Aplica as migrações na subida (produção). Em desenvolvimento, use npm run db:migrate.
MIGRATE_ON_START=false

# Referência interativa da API em /docs (true/false). Sem valor: ligada fora de produção.
DOCS_ENABLED=true

# Proxies confiáveis na frente da API: 0 em desenvolvimento; 2 em produção (Vercel + Render).
TRUST_PROXY=0

# Limite de requisições por IP e de tentativas de login (true/false). Mantenha ligado.
RATE_LIMIT_ENABLED=true

# Fuso do "hoje" nas regras de fatura (aberta, fechada, vencida). Nome IANA.
TIME_ZONE=America/Sao_Paulo
