{
  "name": "gestao-financeira-api",
  "version": "0.0.0",
  "description": "API REST da Gestão Financeira (Fastify, Zod, Drizzle e PostgreSQL).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "openapi": "node scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.3",
    "@scalar/fastify-api-reference": "1.76.4",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
