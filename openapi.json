  },
  "paths": {
    "/health": {
      "get": {
        "summary": "O processo está de pé",
        "tags": ["Operação"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "enum": ["ok"] } },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "A API consegue atender (banco respondendo)",
        "tags": ["Operação"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "enum": ["ready"] } },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "summary": "Cadastra um usuário e abre a sessão",
        "tags": ["Autenticação"],
        "description": "Senha com pelo menos 8 caracteres, uma letra e um número. O e-mail é guardado em minúsculas. A resposta traz o cookie `__Host-session` com o token da sessão (HttpOnly, Secure, SameSite=Lax).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "example": "Pessoa de Exemplo"
                  },
                  "email": {
                    "format": "email",
                    "example": "pessoa@exemplo.com",
                    "type": "string",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128,
                    "pattern": "^(?=.*\\p{L})(?=.*\\d).+$",
                    "example": "senha1234"
                  }
                },
                "required": ["name", "email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "429": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Entra com e-mail e senha",
        "tags": ["Autenticação"],
        "description": "Abre uma sessão nova a cada login. Credenciais inválidas respondem 401 com a mesma mensagem, exista o e-mail ou não. A resposta traz o cookie `__Host-session` com o token da sessão (HttpOnly, Secure, SameSite=Lax).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "format": "email",
                    "example": "pessoa@exemplo.com",
                    "type": "string",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "example": "senha1234"
                  }
                },
                "required": ["email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "429": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Sai da conta",
        "tags": ["Autenticação"],
        "description": "Encerra a sessão do cookie no servidor e pede ao navegador para apagá-lo.",
        "responses": { "204": { "description": "Default Response" } }
      }
    },
    "/v1/auth/me": {
      "get": {
        "summary": "Usuário da sessão atual",
        "tags": ["Autenticação"],
        "description": "Usado pelo front ao abrir o app para restaurar a sessão a partir do cookie.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "summary": "Lista as contas",
        "tags": ["Contas"],
        "description": "Contas do usuário em ordem alfabética. Por padrão, só as ativas.",
        "parameters": [
          {
            "schema": { "default": "false", "type": "string", "enum": ["true", "false"] },
            "in": "query",
            "name": "includeArchived",
            "required": false,
            "description": "Inclui as contas arquivadas na lista (padrão: só as ativas)."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      },
      "post": {
        "summary": "Cadastra uma conta",
        "tags": ["Contas"],
        "description": "A conta pertence ao usuário da sessão. Instituição vazia é gravada como `null`; sem `initialBalance`, o saldo inicial é zero.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "example": "Conta corrente"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["checking", "savings", "cash", "investment", "other"],
                    "description": "Tipo da conta: `checking` (corrente), `savings` (poupança), `cash` (dinheiro), `investment` (investimento) ou `other`."
                  },
                  "institution": {
                    "example": "Banco Exemplo",
                    "anyOf": [{ "type": "string", "maxLength": 60 }, { "type": "null" }]
                  },
                  "initialBalance": {
                    "default": 0,
                    "type": "integer",
                    "minimum": -100000000000,
                    "maximum": 100000000000,
                    "description": "Saldo inicial em centavos; pode ser negativo.",
                    "example": 123456
                  },
                  "color": {
                    "type": "string",
                    "enum": [
                      "#1565c0",
                      "#2e7d32",
