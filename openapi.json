      "patch": {
        "summary": "Edita, arquiva ou reativa uma conta",
        "tags": ["Contas"],
        "description": "Altera só os campos enviados; `institution: null` remove a instituição. Arquivar é `{ \"isArchived\": true }` e reativar, `false`: contas não são excluídas, para preservar o histórico das transações. Conta inexistente ou de outro usuário responde 404.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "example": "Conta corrente"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["checking", "savings", "cash", "investment", "other"],
                    "description": "Tipo da conta: `checking` (corrente), `savings` (poupança), `cash` (dinheiro), `investment` (investimento) ou `other`."
                  },
                  "institution": {
                    "example": "Banco Exemplo",
                    "anyOf": [{ "type": "string", "maxLength": 60 }, { "type": "null" }]
                  },
                  "initialBalance": {
                    "type": "integer",
                    "minimum": -100000000000,
                    "maximum": 100000000000,
                    "description": "Saldo inicial em centavos; pode ser negativo.",
                    "example": 123456
                  },
                  "color": {
                    "type": "string",
                    "enum": [
                      "#1565c0",
                      "#2e7d32",
                      "#6a1b9a",
                      "#c62828",
                      "#ef6c00",
                      "#00838f",
                      "#ad1457",
                      "#546e7a"
                    ]
                  },
                  "icon": {
                    "type": "string",
                    "enum": [
                      "account_balance",
                      "account_balance_wallet",
                      "savings",
                      "payments",
                      "trending_up",
                      "credit_card",
                      "store",
                      "home"
                    ],
                    "description": "Ícone do Material Symbols."
                  },
                  "isArchived": {
                    "type": "boolean",
                    "description": "true arquiva a conta (some da lista padrão); false a reativa."
                  }
                },
                "additionalProperties": false
              }
            }
          }
