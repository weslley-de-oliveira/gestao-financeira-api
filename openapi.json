{
  "openapi": "3.1.0",
  "info": {
    "title": "Gestão Financeira API",
    "description": "API REST da Gestão Financeira. Erros seguem o formato Problem Details (RFC 9457); valores monetários em centavos inteiros.",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "ProblemDetailsInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo do problema; `about:blank` quando o status já basta.",
            "example": "about:blank"
          },
          "title": { "type": "string", "example": "Recurso não encontrado" },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "example": 404
          },
          "detail": { "type": "string" },
          "instance": { "type": "string", "description": "Caminho da requisição que falhou." },
          "requestId": {
            "type": "string",
            "description": "Mesmo valor do cabeçalho `x-request-id`."
          },
          "errors": {
            "description": "Só em erros de validação: um item por campo inválido.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Caminho do campo (ex.: `body.amount`)."
                },
                "message": { "type": "string" }
              },
              "required": ["field", "message"]
            }
          }
        },
        "required": ["type", "title", "status", "detail", "instance", "requestId"]
      },
      "AccountInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["checking", "savings", "cash", "investment", "other"],
            "description": "Tipo da conta: `checking` (corrente), `savings` (poupança), `cash` (dinheiro), `investment` (investimento) ou `other`."
          },
          "institution": { "type": ["string", "null"] },
          "initialBalance": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Saldo inicial em centavos; pode ser negativo."
          },
          "color": {
            "type": "string",
            "enum": [
              "#1565c0",
              "#2e7d32",
              "#6a1b9a",
              "#c62828",
              "#ef6c00",
              "#00838f",
              "#ad1457",
              "#546e7a"
            ]
          },
          "icon": {
            "type": "string",
            "enum": [
              "account_balance",
              "account_balance_wallet",
              "savings",
              "payments",
              "trending_up",
              "credit_card",
              "store",
              "home"
            ],
            "description": "Ícone do Material Symbols."
          },
          "isArchived": { "type": "boolean" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "institution",
          "initialBalance",
          "color",
          "icon",
          "isArchived",
          "createdAt"
        ]
      },
      "UserInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "name", "email", "createdAt"]
      },
      "CategoryInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["expense", "income"],
            "description": "Tipo da categoria: `expense` (despesa) ou `income` (receita)."
          },
          "icon": {
            "type": "string",
            "enum": [
              "restaurant",
              "shopping_cart",
              "home",
              "directions_car",
              "directions_bus",
              "local_hospital",
              "school",
              "sports_esports",
              "shopping_bag",
              "receipt_long",
              "bolt",
              "wifi",
              "pets",
              "flight",
              "fitness_center",
              "checkroom",
              "work",
              "laptop",
              "trending_up",
              "card_giftcard",
              "payments",
              "more_horiz"
            ],
            "description": "Ícone do Material Symbols."
          },
          "color": {
            "type": "string",
            "enum": [
              "#1565c0",
              "#2e7d32",
              "#6a1b9a",
              "#c62828",
              "#ef6c00",
              "#00838f",
              "#ad1457",
              "#546e7a"
            ]
          },
          "isDefault": {
            "type": "boolean",
            "description": "Criada com o conjunto inicial do cadastro; `false` nas criadas pelo usuário."
          },
          "isArchived": { "type": "boolean" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "name", "type", "icon", "color", "isDefault", "isArchived", "createdAt"]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo do problema; `about:blank` quando o status já basta.",
            "example": "about:blank"
          },
          "title": { "type": "string", "example": "Recurso não encontrado" },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "example": 404
          },
          "detail": { "type": "string" },
          "instance": { "type": "string", "description": "Caminho da requisição que falhou." },
          "requestId": {
            "type": "string",
            "description": "Mesmo valor do cabeçalho `x-request-id`."
          },
          "errors": {
            "description": "Só em erros de validação: um item por campo inválido.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Caminho do campo (ex.: `body.amount`)."
                },
                "message": { "type": "string" }
              },
              "required": ["field", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["type", "title", "status", "detail", "instance", "requestId"],
        "additionalProperties": false
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["checking", "savings", "cash", "investment", "other"],
            "description": "Tipo da conta: `checking` (corrente), `savings` (poupança), `cash` (dinheiro), `investment` (investimento) ou `other`."
          },
          "institution": { "type": ["string", "null"] },
          "initialBalance": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Saldo inicial em centavos; pode ser negativo."
          },
          "color": {
            "type": "string",
            "enum": [
              "#1565c0",
              "#2e7d32",
