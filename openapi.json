{
  "openapi": "3.1.0",
  "info": {
    "title": "Gestão Financeira API",
    "description": "API REST da Gestão Financeira. Erros seguem o formato Problem Details (RFC 9457); valores monetários em centavos inteiros.",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "ProblemDetailsInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo do problema; `about:blank` quando o status já basta.",
            "example": "about:blank"
          },
          "title": { "type": "string", "example": "Recurso não encontrado" },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "example": 404
          },
          "detail": { "type": "string" },
          "instance": { "type": "string", "description": "Caminho da requisição que falhou." },
          "requestId": {
            "type": "string",
            "description": "Mesmo valor do cabeçalho `x-request-id`."
          },
          "errors": {
            "description": "Só em erros de validação: um item por campo inválido.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Caminho do campo (ex.: `body.amount`)."
                },
                "message": { "type": "string" }
              },
              "required": ["field", "message"]
            }
          }
        },
        "required": ["type", "title", "status", "detail", "instance", "requestId"]
      },
      "UserInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "name", "email", "createdAt"]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo do problema; `about:blank` quando o status já basta.",
            "example": "about:blank"
          },
          "title": { "type": "string", "example": "Recurso não encontrado" },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "example": 404
          },
          "detail": { "type": "string" },
          "instance": { "type": "string", "description": "Caminho da requisição que falhou." },
          "requestId": {
            "type": "string",
            "description": "Mesmo valor do cabeçalho `x-request-id`."
          },
          "errors": {
            "description": "Só em erros de validação: um item por campo inválido.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Caminho do campo (ex.: `body.amount`)."
                },
                "message": { "type": "string" }
              },
              "required": ["field", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["type", "title", "status", "detail", "instance", "requestId"],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "name", "email", "createdAt"],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "O processo está de pé",
        "tags": ["Operação"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "enum": ["ok"] } },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "A API consegue atender (banco respondendo)",
        "tags": ["Operação"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "enum": ["ready"] } },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "summary": "Cadastra um usuário e abre a sessão",
        "tags": ["Autenticação"],
        "description": "Senha com pelo menos 8 caracteres, uma letra e um número. O e-mail é guardado em minúsculas. A resposta traz o cookie `__Host-session` com o token da sessão (HttpOnly, Secure, SameSite=Lax).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "example": "Pessoa de Exemplo"
                  },
                  "email": {
                    "format": "email",
                    "example": "pessoa@exemplo.com",
                    "type": "string",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128,
                    "pattern": "^(?=.*\\p{L})(?=.*\\d).+$",
                    "example": "senha1234"
                  }
                },
                "required": ["name", "email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "429": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Entra com e-mail e senha",
        "tags": ["Autenticação"],
        "description": "Abre uma sessão nova a cada login. Credenciais inválidas respondem 401 com a mesma mensagem, exista o e-mail ou não. A resposta traz o cookie `__Host-session` com o token da sessão (HttpOnly, Secure, SameSite=Lax).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "format": "email",
                    "example": "pessoa@exemplo.com",
                    "type": "string",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "example": "senha1234"
                  }
                },
                "required": ["email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "429": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Sai da conta",
        "tags": ["Autenticação"],
        "description": "Encerra a sessão do cookie no servidor e pede ao navegador para apagá-lo.",
        "responses": { "204": { "description": "Default Response" } }
      }
    },
    "/v1/auth/me": {
      "get": {
        "summary": "Usuário da sessão atual",
        "tags": ["Autenticação"],
        "description": "Usado pelo front ao abrir o app para restaurar a sessão a partir do cookie.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    }
  },
  "tags": [
    { "name": "Operação", "description": "Saúde e prontidão da API." },
    { "name": "Autenticação", "description": "Cadastro, login, sessão e logout." }
  ]
}
